<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- noVNC (bundled in assets/novnc) renders inside this WebView. -->
    <WebView
        android:id="@+id/vncWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/connectingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="جاري تشغيل سطح المكتب..."
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

    <!--
      Small floating toolbar overlaying the desktop. Needed because:
      - a WebView showing a canvas-rendered remote desktop does not
        reliably trigger Android's on-screen keyboard on tap the way a
        real text field would, so an explicit toggle is provided.
      - there's no system back/home gesture equivalent once the remote
        XFCE desktop has full-screen focus, so an explicit exit button
        is provided instead of relying on the system back gesture (which
        the WebView may consume/pass to the remote desktop instead).
    -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:orientation="horizontal"
        android:background="#66000000"
        android:padding="6dp">

        <ImageButton
            android:id="@+id/toggleKeyboardButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_edit"
            android:contentDescription="لوحة المفاتيح" />

        <ImageButton
            android:id="@+id/toggleSpecialKeysButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_manage"
            android:contentDescription="مفاتيح خاصة" />

        <ImageButton
            android:id="@+id/exitDesktopButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="خروج" />

    </LinearLayout>

    <!-- Invisible field used purely to summon/dismiss the system IME. -->
    <EditText
        android:id="@+id/hiddenKeyboardTrigger"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:layout_gravity="top|start"
        android:background="@android:color/transparent"
        android:importantForAutofill="no" />

    <!--
      Special-keys row: physical keyboards on a phone have no Ctrl/Alt/Esc
      row, and those keys are essential for real desktop use (copy/paste,
      Alt+Tab, Esc to cancel dialogs). Sits above the system keyboard when
      it's open, hidden otherwise.
    -->
    <HorizontalScrollView
        android:id="@+id/specialKeysScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC1B1B1B"
        android:visibility="gone"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp">

            <ToggleButton
                android:id="@+id/ctrlToggle"
                style="@style/SpecialKeyButton"
                android:textOn="Ctrl"
                android:textOff="Ctrl" />

            <ToggleButton
                android:id="@+id/altToggle"
                style="@style/SpecialKeyButton"
                android:textOn="Alt"
                android:textOff="Alt" />

            <Button
                android:id="@+id/escKey"
                style="@style/SpecialKeyButton"
                android:text="Esc" />

            <Button
                android:id="@+id/tabKey"
                style="@style/SpecialKeyButton"
                android:text="Tab" />

            <Button
                android:id="@+id/leftKey"
                style="@style/SpecialKeyButton"
                android:text="◀" />

            <Button
                android:id="@+id/upKey"
                style="@style/SpecialKeyButton"
                android:text="▲" />

            <Button
                android:id="@+id/downKey"
                style="@style/SpecialKeyButton"
                android:text="▼" />

            <Button
                android:id="@+id/rightKey"
                style="@style/SpecialKeyButton"
                android:text="▶" />

        </LinearLayout>
    </HorizontalScrollView>

</FrameLayout>
